{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tid-kopru.invalid/schema/sign-pilot-record-v1.json",
  "title": "TİD Köprü sign-pilot landmark record",
  "description": "Pseudonymous landmark data only. Approved sign IDs and consent evidence are managed outside this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signerCode",
    "consentCode",
    "signId",
    "repetition",
    "conditions",
    "fps",
    "frames",
    "preprocessVersion"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "signerCode": { "$ref": "#/$defs/code" },
    "consentCode": { "$ref": "#/$defs/code" },
    "signId": { "$ref": "#/$defs/code" },
    "repetition": { "type": "integer", "minimum": 1 },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lightingCode", "distanceCode", "backgroundCode"],
      "properties": {
        "lightingCode": { "$ref": "#/$defs/code" },
        "distanceCode": { "$ref": "#/$defs/code" },
        "backgroundCode": { "$ref": "#/$defs/code" }
      }
    },
    "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    },
    "preprocessVersion": { "$ref": "#/$defs/code" }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "coordinates": {
      "type": "array",
      "items": { "type": "number" }
    },
    "visibility": {
      "type": "array",
      "items": { "type": "number", "enum": [0, 1] }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestampMs",
        "pose",
        "poseVisibility",
        "leftHand",
        "leftHandVisibility",
        "rightHand",
        "rightHandVisibility",
        "face",
        "faceVisibility"
      ],
      "properties": {
        "timestampMs": { "type": "number", "minimum": 0 },
        "pose": { "$ref": "#/$defs/coordinates" },
        "poseVisibility": { "$ref": "#/$defs/visibility" },
        "leftHand": { "$ref": "#/$defs/coordinates" },
        "leftHandVisibility": { "$ref": "#/$defs/visibility" },
        "rightHand": { "$ref": "#/$defs/coordinates" },
        "rightHandVisibility": { "$ref": "#/$defs/visibility" },
        "face": { "$ref": "#/$defs/coordinates" },
        "faceVisibility": { "$ref": "#/$defs/visibility" }
      }
    }
  }
}
