{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tid-kopru.invalid/schema/sign-pilot-utterance-v2.json",
  "title": "TİD Köprü consented utterance landmark record",
  "description": "Pseudonymous landmark and reviewed gloss timeline only; consent evidence and signer identity mapping remain outside this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "utteranceId",
    "signerCode",
    "consentCode",
    "scopeId",
    "fps",
    "frames",
    "glossEvents",
    "sampleKind",
    "conditions",
    "preprocessVersion",
    "captureContractSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "utteranceId": { "$ref": "#/$defs/code" },
    "signerCode": { "$ref": "#/$defs/code" },
    "consentCode": { "$ref": "#/$defs/code" },
    "scopeId": { "$ref": "#/$defs/code" },
    "fps": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/frame" }
    },
    "glossEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/glossEvent" }
    },
    "sampleKind": { "enum": ["SIGN", "BLANK", "UNKNOWN", "PARTIAL"] },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lightingCode", "distanceCode", "backgroundCode"],
      "properties": {
        "lightingCode": { "$ref": "#/$defs/code" },
        "distanceCode": { "$ref": "#/$defs/code" },
        "backgroundCode": { "$ref": "#/$defs/code" }
      }
    },
    "preprocessVersion": { "$ref": "#/$defs/code" },
    "captureContractSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "sampleKind": { "const": "SIGN" } }, "required": ["sampleKind"] },
      "then": { "properties": { "glossEvents": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "sampleKind": { "enum": ["BLANK", "UNKNOWN", "PARTIAL"] } }, "required": ["sampleKind"] },
      "then": { "properties": { "glossEvents": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "code": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
    "coordinates": { "type": "array", "minItems": 3, "items": { "type": "number" } },
    "visibility": { "type": "array", "items": { "type": "number", "enum": [0, 1] } },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestampMs", "pose", "poseVisibility", "leftHand", "leftHandVisibility",
        "rightHand", "rightHandVisibility", "face", "faceVisibility"
      ],
      "properties": {
        "timestampMs": { "type": "number", "minimum": 0 },
        "pose": { "$ref": "#/$defs/coordinates" },
        "poseVisibility": { "$ref": "#/$defs/visibility" },
        "leftHand": { "$ref": "#/$defs/coordinates" },
        "leftHandVisibility": { "$ref": "#/$defs/visibility" },
        "rightHand": { "$ref": "#/$defs/coordinates" },
        "rightHandVisibility": { "$ref": "#/$defs/visibility" },
        "face": { "$ref": "#/$defs/coordinates" },
        "faceVisibility": { "$ref": "#/$defs/visibility" }
      }
    },
    "glossEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glossId", "startMs", "endMs", "dominantHand", "nonManual", "channel"],
      "properties": {
        "glossId": { "$ref": "#/$defs/code" },
        "startMs": { "type": "number", "minimum": 0 },
        "endMs": { "type": "number", "exclusiveMinimum": 0 },
        "dominantHand": { "enum": ["left", "right", "both", "none"] },
        "nonManual": { "type": "array", "items": { "$ref": "#/$defs/code" } },
        "channel": { "enum": ["manual", "nonManual"] },
        "parallelGroup": { "$ref": "#/$defs/code" },
        "spatialReference": { "$ref": "#/$defs/code" }
      }
    }
  }
}
